# TrunkScope environment — development bootstrap
# For the supported appliance path, use deploy/appliance.env.example instead.
#
# The multi-service Compose stack (deploy/compose.yml) is DEFERRED.
# TRUNKSCOPE_DATABASE_URL below applies only to that legacy layout.

TRUNKSCOPE_BIND=127.0.0.1:8080
TRUNKSCOPE_DATABASE_URL=postgres://trunkscope:trunkscope@127.0.0.1:5432/trunkscope
TRUNKSCOPE_STORAGE_PATH=./data/audio
TRUNKSCOPE_SIMULATOR=true
TRUNKSCOPE_RADIO_MODE=simulator
TRUNKSCOPE_PUBLIC_FEED=false
TRUNKSCOPE_PUBLIC_DELAY_SECONDS=120
TRUNKSCOPE_RADIO_DEVICE=driver=remote,remote=tcp://192.168.1.50:55132,remote:driver=sdrplay,remote:format=CS16
TRUNKSCOPE_RADIO_FREQUENCY_HZ=851012500
TRUNKSCOPE_RADIO_SAMPLE_RATE_HZ=2400000
TRUNKSCOPE_RADIO_BANDWIDTH_HZ=1536000
TRUNKSCOPE_RADIO_GAIN_DB=
TRUNKSCOPE_RADIO_AGC=false
TRUNKSCOPE_RADIO_PPM=0
TRUNKSCOPE_AI_ENABLED=false
TRUNKSCOPE_TRANSCRIBE_URL=http://speaches:8000/v1/audio/transcriptions
TRUNKSCOPE_TRANSCRIBE_MODEL=Systran/faster-distil-whisper-small.en
TRUNKSCOPE_SUMMARY_URL=http://ollama:11434/api/generate
TRUNKSCOPE_SUMMARY_MODEL=llama3.2:3b
