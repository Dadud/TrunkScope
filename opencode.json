{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git rebase*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git config*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  }
}
