# Copy to .env and adjust for your GPU host.
# TrunkScope transcribeUrl should use this machine's LAN IP, not localhost.
# Example: http://192.168.1.105:8000/v1/audio/transcriptions

VLLM_ASR_PORT=8000
VLLM_ASR_MODEL=chrullis/qwen3-asr-radio-1.7b
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=4
