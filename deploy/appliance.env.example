# TrunkScope appliance environment
# Copy to .env beside deploy/appliance.yml or export before docker compose up.
# Persisted settings in the web UI override these after first save.

# Published port on the host
TRUNKSCOPE_HTTP_PORT=18088

# Image (build locally or pull from GHCR)
# TRUNKSCOPE_IMAGE=ghcr.io/dadud/trunkscope:latest

# Appdata volume — single mount for SQLite, settings, and WAVs
TRUNKSCOPE_APPDATA=trunkscope-data

# Radio
TRUNKSCOPE_RADIO_MODE=decoder
TRUNKSCOPE_RADIO_DEVICE=soapy=0,driver=rtlsdr
# TRUNKSCOPE_RADIO_DEVICE=soapy=0,driver=sdrplay
# TRUNKSCOPE_SITE_FILTER=black river falls

# Security — never enable on a public-facing port
TRUNKSCOPE_LOCAL_ONLY=false

# AI (optional — configure in web UI or set LAN URLs here)
TRUNKSCOPE_AI_ENABLED=false
# Use LAN IP, not localhost:
# TRUNKSCOPE_TRANSCRIBE_URL=http://192.168.1.10:8000/v1/audio/transcriptions
# TRUNKSCOPE_TRANSCRIBE_API_KEY=
# TRUNKSCOPE_TRANSCRIBE_MODEL=Systran/faster-distil-whisper-small.en
# TRUNKSCOPE_SUMMARY_URL=http://192.168.1.10:11434/api/generate
# TRUNKSCOPE_SUMMARY_API_KEY=
# TRUNKSCOPE_SUMMARY_MODEL=llama3.2:3b
# TRUNKSCOPE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# TRUNKSCOPE_GEOCODER_API_KEY=

# USB passthrough
TRUNKSCOPE_USB_DEVICES=/dev/bus/usb:/dev/bus/usb

# SDRplay only — mount licensed runtime read-only
# TRUNKSCOPE_SDRPLAY_RUNTIME=/mnt/user/appdata/trunkscope/sdrplay
