[Unit]
Description=TrunkScope native SDR and decoder service
After=network-online.target
[Service]
Type=simple
User=trunkscope
Group=trunkscope
SupplementaryGroups=plugdev
ExecStart=/usr/local/bin/trunkscope-radiod
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trunkscope /var/log/trunkscope
[Install]
WantedBy=multi-user.target
