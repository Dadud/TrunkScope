COMPOSE_PROJECT_NAME=trunkscope

# Store application state on the Unraid cache pool, not the array.
TRUNKSCOPE_POSTGRES_DATA=/mnt/user/appdata/trunkscope/postgres
TRUNKSCOPE_MINIO_DATA=/mnt/user/appdata/trunkscope/minio
TRUNKSCOPE_AUDIO_DATA=/mnt/user/appdata/trunkscope/audio
TRUNKSCOPE_CALLS_DATA=/mnt/user/appdata/trunkscope/calls
TRUNKSCOPE_HUGGINGFACE_DATA=/mnt/user/appdata/trunkscope/huggingface
TRUNKSCOPE_OLLAMA_DATA=/mnt/user/appdata/trunkscope/ollama

TRUNKSCOPE_HTTP_PORT=8088
TRUNKSCOPE_SIMULATOR=true
TRUNKSCOPE_RADIO_MODE=simulator
TRUNKSCOPE_PUBLIC_FEED=false
TRUNKSCOPE_POSTGRES_PASSWORD=change-this-long-random-password

# Local SDR option: leave this default for USB SDRs attached to Unraid.
# For remote RSP1B use TRUNKSCOPE_RADIO_MODE=decoder and the generated remote config.
TRUNKSCOPE_USB_DEVICES=/dev/bus/usb:/dev/bus/usb
